<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイ常駐に System.Windows.Forms.NotifyIcon を使うため -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LiveDictation</AssemblyName>
    <RootNamespace>LiveDictation</RootNamespace>
    <!-- sherpa-onnx のネイティブ実体が win-x64 のみのため固定する -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
  </ItemGroup>

</Project>
